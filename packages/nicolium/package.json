{
  "name": "nicolium",
  "displayName": "Nicolium",
  "version": "2.0.0",
  "description": "Mastodon-compatible social media front-end",
  "keywords": [
    "fediverse",
    "pleroma"
  ],
  "homepage": "https://codeberg.org/nicolium/nicolium",
  "bugs": {
    "url": "https://codeberg.org/nicolium/nicolium/issues"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/nicolium/nicolium"
  },
  "type": "module",
  "scripts": {
    "start": "vite serve",
    "dev": "vite serve",
    "build": "vite build --emptyOutDir",
    "preview": "vite preview",
    "audit:fix": "vite audit --fix",
    "i18n": "formatjs extract 'src/**/*.{ts,tsx}' --ignore '**/*.d.ts' --out-file build/messages.json && npx formatjs compile build/messages.json --out-file src/locales/en.json",
    "lint": "pnpm run lint:js && pnpm run lint:sass",
    "lint:js": "oxlint",
    "lint:sass": "stylelint src/**/*.{css,scss}",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "precommit": "lint-staged"
  },
  "dependencies": {
