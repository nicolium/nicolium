    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "postcss": "^8.5.32",
    "rollup-plugin-bundle-stats": "^4.23.1",
    "sass-embedded": "^1.108.2",
    "stylelint": "^18.0.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "stylelint-order": "^8.1.3",
    "tslib": "^2.9.1",
    "type-fest": "^5.10.0",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-compile-time": "^0.4.6",
