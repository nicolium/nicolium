{
  "expo": {
    "name": "micolium",
    "slug": "micolium",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "micolium",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.nicolium.micolium",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "28NDJH3G7W",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#00FFDE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.nicolium.micolium"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "experiments": {
      "reactCompiler": true
    },
    "plugins": [
      "expo-image",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      [
        "./plugins/with-material3-theme.ts",
        {
          "theme": "material3-expressive"
        }
      ],
      [
        "./plugins/with-android-drawables.ts",
        {
          "drawableFiles": [
            "./node_modules/@phosphor-icons/core/assets/regular/arrow-left.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/arrow-right.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/arrow-square-out.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/arrows-vertical.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/at.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/bell-simple.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/bell-simple-slash.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/bookmark.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/bookmark-simple.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/bookmarks.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/broadcast.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/calendar-plus.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/camera.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/chats-circle.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/circles-four.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/coins.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/envelope-simple.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/export.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/fediverse-logo.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/flag.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/folder-simple.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/funnel.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/globe-simple.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/graph.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/house.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/images.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/link-simple-horizontal.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/list-dashes.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/lock.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/moon.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/paperclip.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/pencil-simple.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/planet.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/plus.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/prohibit.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/push-pin.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/push-pin-slash.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/quotes.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/repeat.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/speaker-simple-x.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/star.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/tooth.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/trash.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/user.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/user-minus.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/user-plus.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/users-three.svg",
            "./node_modules/@phosphor-icons/core/assets/regular/wrench.svg"
          ],
          "prefix": "ph_"
        }
      ],
      "expo-sharing",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "pl"]
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "b848f0e7-82c2-441b-bd09-2afcf86415f1"
      }
    }
  }
}
